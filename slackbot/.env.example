# Copy this file to slackbot/.env and fill in the values.
# (When deploying to a host, set these as the host's environment variables instead.)

# --- Slack (Events API / webhook) ---
# Bot User OAuth Token, starts with xoxb- (OAuth & Permissions page, after installing the app)
SLACK_BOT_TOKEN=xoxb-...
# Signing Secret (Basic Information -> App Credentials). Regenerate it if it was ever exposed.
SLACK_SIGNING_SECRET=...

# --- Anthropic (the bot's brain; bills per use) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Teamleader (same values your connector already uses) ---
TEAMLEADER_CLIENT_ID=
TEAMLEADER_CLIENT_SECRET=
TEAMLEADER_REFRESH_TOKEN=

# --- Optional ---
# Port the web service listens on (hosts usually set PORT for you).
PORT=3000
# Which Claude model the bot runs on.
BOT_MODEL=claude-sonnet-4-6
# Comma-separated Slack user IDs allowed to run WRITE actions (create/change/delete reservations).
# Empty = everyone in the workspace can write (not recommended).
# Find an ID in Slack: click a profile -> three dots -> Copy member ID (looks like U01ABC123).
SLACK_WRITE_ALLOWLIST=

# --- Task capture (optional; on whenever NOTION_TOKEN is set) ---
# "@Pidgi turn this into a task for Laura by Friday" / "put this on the Touchdown agenda"
# -> draft card -> ✅ -> Notion board. Boards and team live in slackbot/taskboards.ts.
# Model for the distil step (defaults to BOT_MODEL).
# TASK_MODEL=claude-sonnet-4-6
# Replace the boards, as a JSON array. A minimal entry becomes a person board with Laura's columns:
# TASK_BOARDS=[{"key":"diego","name":"Diego","email":"diego@peaknine.studio","databaseId":"<notion database id>"}]
# Add or correct team members (name, email, Notion user id), as a JSON array:
# TASK_TEAM=[{"name":"Someone","email":"someone@peaknine.studio","notionId":"<notion user id>"}]
