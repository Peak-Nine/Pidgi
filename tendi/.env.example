# Copy this file to tendi/.env for local runs.
# On Render, set these as the Tendi web service's environment variables instead.
# Never commit a filled-in .env and never paste these values into a doc or a chat.

# --- Slack (the Tendi app, NOT Pidgi's app) ---
# Bot User OAuth Token of the Tendi Slack app (OAuth & Permissions, after installing).
SLACK_BOT_TOKEN=xoxb-...
# Signing Secret of the Tendi Slack app (Basic Information -> App Credentials).
SLACK_SIGNING_SECRET=...

# --- Anthropic (Tendi's brain; bills per use) ---
ANTHROPIC_API_KEY=sk-ant-...
# Model Tendi runs on. Default is an Opus-class model for long-form writing; set
# claude-sonnet-4-6 to run cheaper. Verify the exact model id in the Anthropic console.
TENDI_MODEL=claude-opus-4-8
# Max output tokens per model call (long drafts need room).
TENDI_MAX_TOKENS=16000
# Anthropic server-side web search for client research (1 = on, 0 = off). Billed per search.
TENDI_WEB_SEARCH=1
TENDI_WEB_SEARCH_MAX_USES=8

# --- Teamleader (same integration Pidgi uses; optional) ---
TEAMLEADER_CLIENT_ID=
TEAMLEADER_CLIENT_SECRET=
TEAMLEADER_REFRESH_TOKEN=

# --- Who may trigger writes (Teamleader deal/quotation, Canva copy/edit) ---
# Comma-separated Slack user IDs. Empty = everyone can write (not recommended).
# Find an ID in Slack: profile -> three dots -> Copy member ID (looks like U01ABC123).
TENDI_WRITE_ALLOWLIST=U09GX9K063T,U09GX95SV7B

# --- Public URL and admin key (needed for Canva login, /usage and /canva/status) ---
# The Render URL of THIS service, no trailing slash, e.g. https://tendi.onrender.com
PUBLIC_BASE_URL=
# Long random string. Protects /canva/connect, /canva/status, /usage.
TENDI_ADMIN_KEY=
# Set to 0 to disable the Canva module entirely.
TENDI_CANVA=1
# Canva's hosted MCP server (change only if Canva moves it).
CANVA_MCP_URL=https://mcp.canva.com/mcp
# Optional: seed the Canva OAuth JSON (from /canva/export) on hosts without a persistent disk.
CANVA_OAUTH_JSON=
# Set to 1 to allow GET /canva/export?key=... to return the stored Canva tokens.
TENDI_ALLOW_TOKEN_EXPORT=0

# --- Storage ---
# Where thread state, attachments and the Canva tokens live. Defaults to /var/data
# when that directory exists (Render persistent disk), else the OS temp dir (lost on redeploy).
TENDI_DATA_DIR=
# Max messages kept per thread, and a character cap for the stored history.
TENDI_HISTORY_MAX=40
TENDI_HISTORY_MAX_CHARS=180000

# --- Web service ---
PORT=3000
