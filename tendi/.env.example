# Copy this file to tendi/.env for local runs.
# On Render, set these as the Tendi web service's environment variables instead.
# Never commit a filled-in .env and never paste these values into a doc or a chat.

# --- Slack (the Tendi app, NOT Pidgi's app) ---
# Bot User OAuth Token of the Tendi Slack app (OAuth & Permissions, after installing).
SLACK_BOT_TOKEN=xoxb-...
# Signing Secret of the Tendi Slack app (Basic Information -> App Credentials).
SLACK_SIGNING_SECRET=...

# --- Anthropic (Tendi's brain; bills per use) ---
ANTHROPIC_API_KEY=sk-ant-...
# Model Tendi runs on. Default is an Opus-class model for long-form writing; set
# claude-sonnet-4-6 to run cheaper. Verify the exact model id in the Anthropic console.
TENDI_MODEL=claude-opus-4-8
# Max output tokens per model call (long drafts need room).
TENDI_MAX_TOKENS=16000
# Anthropic server-side web search for client research (1 = on, 0 = off). Billed per search.
TENDI_WEB_SEARCH=1
TENDI_WEB_SEARCH_MAX_USES=8

# --- Teamleader (same integration Pidgi uses; optional) ---
TEAMLEADER_CLIENT_ID=
TEAMLEADER_CLIENT_SECRET=
TEAMLEADER_REFRESH_TOKEN=

# --- Who may trigger writes (Teamleader deal/quotation, Canva copy/edit) ---
# Comma-separated Slack user IDs. Empty = everyone can write (not recommended).
# Find an ID in Slack: profile -> three dots -> Copy member ID (looks like U01ABC123).
TENDI_WRITE_ALLOWLIST=U09GX9K063T,U09GX95SV7B

# --- Public URL and admin key (needed for Canva login, /usage and /canva/status) ---
# The Render URL of THIS service, no trailing slash, e.g. https://tendi.onrender.com
PUBLIC_BASE_URL=
# Long random string. Protects /canva/connect, /canva/status, /usage.
TENDI_ADMIN_KEY=
# Set to 0 to disable the Canva module entirely.
TENDI_CANVA=1
# Canva's hosted MCP server (change only if Canva moves it).
CANVA_MCP_URL=https://mcp.canva.com/mcp
# The Canva login, produced on a laptop by `npm run tendi:canva-login` (Canva only redirects to localhost).
# Read when the disk holds no Canva login yet; afterwards the disk copy (refreshed tokens) wins.
CANVA_OAUTH_JSON=
# Set to 1 to allow GET /canva/export?key=... to return the stored Canva tokens.
TENDI_ALLOW_TOKEN_EXPORT=0

# --- Storage ---
# Where thread state, attachments and the Canva tokens live. Defaults to /var/data
# when that directory exists (Render persistent disk), else the OS temp dir (lost on redeploy).
TENDI_DATA_DIR=
# Max messages kept per thread, and a character cap for the stored history.
TENDI_HISTORY_MAX=40
TENDI_HISTORY_MAX_CHARS=180000

# --- Web service ---
PORT=3000

# --- Tendi Scout (daily tender digest; see README section 7) ---
# Channel ID of the tenders channel (starts with C). Empty = Scout's schedule is off and nothing is posted.
SCOUT_CHANNEL=
# Set to 0 to pause the daily run without removing the channel.
SCOUT_ENABLED=1
# Local time and days of the digest (1 = Monday ... 7 = Sunday), in SCOUT_TZ. Default Monday and Thursday.
SCOUT_TIME=07:30
# No scheduled start after this time (a late-evening deploy waits for the next morning).
SCOUT_LATEST=20:00
SCOUT_DAYS=1,4
SCOUT_TZ=Europe/Brussels
# Model for fit scoring. Falls back to TENDI_MODEL if the API rejects this id.
SCOUT_MODEL=claude-sonnet-4-6
# ReliefWeb API appname, approved by ReliefWeb (https://apidoc.reliefweb.int/parameters#appname). Empty = source skipped.
RELIEFWEB_APPNAME=
# How far back each run looks, and the caps that keep us off API walls. Leave empty: the lookback
# follows SCOUT_DAYS (5 days for Monday and Thursday) and the scoring cap is 30 per day of lookback.
SCOUT_LOOKBACK_DAYS=
SCOUT_MAX_SCORE_PER_RUN=
SCOUT_BATCH=10
SCOUT_MAX_POSTS=15
SCOUT_ENABEL_MAX_PAGES=3
# Read the decisive pages (cover, award criteria, terms of reference, selection file) of this
# many Enabel tender PDFs per run, each in a separate helper process (about 150 MB). 0 = off.
SCOUT_ENABEL_PDF_MAX=30
SCOUT_TED_MAX_PAGES=
# Optional overrides: TED CPV codes (space separated), UNDP feeds (all, RAF, RAB, RAS, RER, RLA, HQ).
SCOUT_TED_CPV=
SCOUT_UNDP_FEEDS=all
# World Bank: pages of 100 notices per run, and whether to keep individual-consultant posts (0 = leave out).
SCOUT_WORLDBANK_MAX_PAGES=4
SCOUT_WORLDBANK_INDIVIDUAL=0
# Keep "national consultant" roles (nationals of the country only). 0 = drop them.
SCOUT_KEEP_NATIONAL=0
# Post a header even when nothing scored above weak (1 = yes).
SCOUT_POST_EMPTY=1
